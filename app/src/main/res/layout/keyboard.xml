<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gl_keyboard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="10dp"
    android:columnCount="4"
    android:rowCount="6"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_columnSpan="4"
        android:layout_columnWeight="2"
        android:gravity="center"
        android:text="请  输  入  取  货  码 "
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_columnSpan="4"
        android:layout_columnWeight="2"
        android:gravity="center"
        android:layout_marginTop="5dp"
        android:text="骑手请输入订单后六位"
        android:textColor="@color/white"
        android:textSize="25sp"
        android:textStyle="bold"
        />

    <TextView
        android:id="@+id/tv_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_columnSpan="4"
        android:layout_columnWeight="2"
        android:layout_marginTop="5dp"
        android:background="@color/white"
        android:gravity="center"
        android:maxLength="6"
        android:padding="10dp"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_one"
        android:layout_columnWeight="1"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="1"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_two"
        android:layout_columnWeight="1"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="2"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_three"
        android:layout_columnWeight="1"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="3"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_four"
        android:layout_columnWeight="1"
        android:layout_marginTop="20dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="4"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_five"
        android:layout_columnWeight="1"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="5"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_six"
        android:layout_columnWeight="1"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="6"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_seven"
        android:layout_columnWeight="1"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="7"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_eight"
        android:layout_columnWeight="1"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="8"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_nine"
        android:layout_columnWeight="1"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="9"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_zero"
        android:layout_columnWeight="1"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="0"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_delete"
        android:layout_columnSpan="2"
        android:layout_columnWeight="2"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="删除"
        android:textColor="@color/black"
        android:textSize="40sp"
        />

    <Button
        android:id="@+id/bt_confirm"
        android:layout_width="match_parent"
        android:layout_columnSpan="4"
        android:layout_columnWeight="2"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_background"
        android:padding="15dp"
        android:text="确认"
        android:textColor="@color/black"
        android:textSize="40sp"
        />
</GridLayout>
